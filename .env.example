# Databricks Apps automatically injects DATABRICKS_HOST, DATABRICKS_CLIENT_ID,
# DATABRICKS_CLIENT_SECRET and DATABRICKS_APP_PORT; never write their values into this file.

# Required: fixture | connected_readonly | connected; fixture refuses to start inside Apps.
UCGOV_MODE=fixture
# Synthetic actor from the fixed fixture identity list; clear this in connected modes.
UCGOV_FIXTURE_ACTOR=alice.steward
# Explicit environment label displayed in the UI; never inferred from workspace names.
UCGOV_ENVIRONMENT_LABEL=DEV
# Comma-separated managed catalogs; empty means all visible catalogs.
UCGOV_MANAGED_CATALOGS=synthetic_catalog
# JSON role-to-account-group mapping; configure real mappings outside this example.
UCGOV_ROLE_GROUPS={}
# Plan expiry in seconds; default is 600.
UCGOV_PLAN_TTL_SECONDS=600
# Support contact displayed for assistance; replace with your configured contact.
UCGOV_SUPPORT_CONTACT=support@example.invalid
# Enable separation of duties, including prevention of self-approval.
UCGOV_SOD_ENABLED=true
# For connected laptop development, set cli_profile to use the developer's own CLI identity.
UCGOV_LOCAL_AUTH=
# Optional bootstrap admin allowlist for connected_readonly/dev only; leave empty by default.
UCGOV_BOOTSTRAP_ADMINS=
# Optional SQL warehouse; without it, lineage, Databricks audit and SQL-based modules degrade.
UCGOV_WAREHOUSE_ID=
# Plan HMAC key: supplied from a Databricks Apps secret resource in production; no secret here.
UCGOV_PLAN_HMAC_KEY=
# Optional Account API account ID; configure Account API credentials separately.
UCGOV_ACCOUNT_ID=

# Optional Lakebase host; empty leaves durable workflow storage unconfigured.
PGHOST=
# Optional Lakebase port; PostgreSQL default is 5432.
PGPORT=5432
# Optional Lakebase database name; configure when enabling durable workflow storage.
PGDATABASE=
# Optional Lakebase database user; configure through the authorized resource setup.
PGUSER=
# Optional Lakebase TLS mode; require certificate and hostname verification.
PGSSLMODE=verify-full
# Optional Lakebase connection application name for diagnostics.
PGAPPNAME=uc-governance-app
