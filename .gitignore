# Build and dependency output. None of this belongs in the deployed app bundle,
# and `databricks sync` must never upload it.
.venv/
node_modules/
frontend/dist/
__pycache__/
*.py[cod]

# Tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.vite/
coverage/
playwright-report/
test-results/

# Orchestration transcripts. Run records are state, logs are noise.
.ai/logs/

# Local configuration. Never commit real credentials.
.env
.env.local

# pytest tmp_path roots created by the backend suite. Several names are in use because
# different dispatches configured their own basetemp; all are unreadable by other processes
# on Windows and none is ever shippable, so `databricks sync` must not see them.
# Agents keep inventing new basetemp names, so match the shape rather than each name.
.pytest-*/
pytest-tmp*/
